<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:WPF.ViewModels"
        xmlns:views="clr-namespace:WPF.Views"
        mc:Ignorable="d"
        Title="WebAppMaps - Gestion des Salles" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:SalleListViewModel}">
            <views:SalleListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:EtageViewModel}">
            <views:EtageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CreateSalleViewModel}">
            <views:CreateSalleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CreateEtageViewModel}">
            <views:CreateEtageView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📍" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="WebAppMaps" FontSize="24" FontWeight="Bold" 
                              Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🏠 Rechercher Salles" 
                           Command="{Binding NavigateToSalleListCommand}"
                           Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="➕ Créer Salle" 
                           Command="{Binding NavigateToCreateSalleCommand}"
                           Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="🏢 Créer Étage" 
                           Command="{Binding NavigateToCreateEtageCommand}"
                           Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" 
                       Margin="10"/>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#34495E" Padding="10,5">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" 
                          Foreground="White" 
                          VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentDateTime, StringFormat='dd/MM/yyyy HH:mm'}" 
                          Foreground="#BDC3C7"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
