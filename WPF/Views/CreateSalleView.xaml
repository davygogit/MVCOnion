<UserControl x:Class="WPF.Views.CreateSalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:WPF.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=viewmodels:CreateSalleViewModel}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource CardStyle}" MaxWidth="850" Margin="20">
            <StackPanel>
                <TextBlock Text="➕ Créer une nouvelle salle" 
                          FontSize="24" 
                          FontWeight="Bold"
                          Margin="0,0,0,20"/>

                <!-- Informations de base -->
                <GroupBox Header="Informations de base" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                            <Label Content="Nom de la salle *"/>
                            <TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                            <Label Content="Numéro *"/>
                            <TextBox Text="{Binding Numero, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                            <Label Content="Étage *"/>
                            <ComboBox ItemsSource="{Binding Etages}"
                                     SelectedItem="{Binding SelectedEtage}"
                                     DisplayMemberPath="Nom"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                            <Label Content="Type de salle *"/>
                            <ComboBox SelectedItem="{Binding SelectedTypeSalle}">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:String>Reunion</sys:String>
                                        <sys:String>Pause</sys:String>
                                        <sys:String>Bubble</sys:String>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="5">
                            <Label Content="Nombre de places"/>
                            <TextBox Text="{Binding NbPlaces, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="5">
                            <Label Content="Nombre de tables"/>
                            <TextBox Text="{Binding NbTables, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="5">
                            <Label Content="Image de la salle"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                                        Text="{Binding ImagePath, Mode=OneWay}"
                                        IsReadOnly="True"
                                        Margin="0,0,5,0"/>
                                <Button Grid.Column="1" 
                                       Content="📁 Parcourir"
                                       Command="{Binding SelectImageCommand}"
                                       Style="{StaticResource SecondaryButtonStyle}"
                                       Padding="10,5"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Coordonnées -->
                <GroupBox Header="Coordonnées sur le plan" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="5">
                            <Label Content="Coordonnée X"/>
                            <TextBox Text="{Binding CoordonneeX, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5">
                            <Label Content="Coordonnée Y"/>
                            <TextBox Text="{Binding CoordonneeY, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Salle Réunion -->
                <GroupBox Header="Équipements salle de réunion" 
                         Visibility="{Binding SelectedTypeSalle, Converter={StaticResource TypeSalleVisibilityConverter}, ConverterParameter=Reunion}"
                         Margin="0,0,0,15">
                    <WrapPanel>
                        <CheckBox Content="Écran" IsChecked="{Binding Ecran}" Margin="10,5"/>
                        <CheckBox Content="Caméra" IsChecked="{Binding Camera}" Margin="10,5"/>
                        <CheckBox Content="Tableau blanc" IsChecked="{Binding TableauBlanc}" Margin="10,5"/>
                        <CheckBox Content="Système audio" IsChecked="{Binding SystemeAudio}" Margin="10,5"/>
                    </WrapPanel>
                </GroupBox>

                <!-- Salle Pause -->
                <GroupBox Header="Équipements salle de pause" 
                         Visibility="{Binding SelectedTypeSalle, Converter={StaticResource TypeSalleVisibilityConverter}, ConverterParameter=Pause}"
                         Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                            <Label Content="Nombre de micro-ondes"/>
                            <TextBox Text="{Binding MicroOndes, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                            <Label Content="Nombre d'éviers"/>
                            <TextBox Text="{Binding Evier, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <CheckBox Grid.Row="1" Grid.Column="0" 
                                 Content="Frigo" 
                                 IsChecked="{Binding Frigo}" 
                                 Margin="10,5"/>
                        
                        <CheckBox Grid.Row="1" Grid.Column="1" 
                                 Content="Distributeur automatique" 
                                 IsChecked="{Binding Distributeur}" 
                                 Margin="10,5"/>
                    </Grid>
                </GroupBox>

                <!-- Salle Bubble -->
                <GroupBox Header="Équipements salle bubble" 
                         Visibility="{Binding SelectedTypeSalle, Converter={StaticResource TypeSalleVisibilityConverter}, ConverterParameter=Bubble}"
                         Margin="0,0,0,15">
                    <CheckBox Content="Prises électriques" IsChecked="{Binding PriseElectrique}" Margin="10,5"/>
                </GroupBox>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right" 
                           Margin="0,20,0,0">
                    <Button Content="❌ Annuler"
                           Command="{Binding CancelCommand}"
                           Style="{StaticResource SecondaryButtonStyle}"
                           Margin="0,0,10,0"/>
                    
                    <Button Content="✅ Créer la salle"
                           Command="{Binding SaveCommand}"
                           Style="{StaticResource PrimaryButtonStyle}"
                           IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>

                <!-- Saving Indicator -->
                <TextBlock Text="⏳ Enregistrement en cours..."
                          FontSize="14"
                          Foreground="Gray"
                          HorizontalAlignment="Center"
                          Margin="0,10,0,0"
                          Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
