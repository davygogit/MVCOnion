<UserControl x:Class="WPF.Views.SalleListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:WPF.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewmodels:SalleListViewModel}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filters Section -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search and Filters -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Width="250" 
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            VerticalContentAlignment="Center"
                            Margin="0,0,10,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="🔍 Rechercher une salle..." 
                                                                  Foreground="Gray" 
                                                                  Margin="10,0,0,0"
                                                                  VerticalAlignment="Center"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <ComboBox Width="150" 
                             ItemsSource="{Binding Etages}"
                             SelectedItem="{Binding SelectedEtage}"
                             DisplayMemberPath="Nom"
                             Margin="0,0,10,0">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="SelectedIndex" Value="-1"/>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <ComboBox Width="150" 
                             SelectedItem="{Binding SelectedTypeSalle}"
                             Margin="0,0,10,0">
                        <ComboBox.ItemsSource>
                            <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                <sys:String>Reunion</sys:String>
                                <sys:String>Pause</sys:String>
                                <sys:String>Bubble</sys:String>
                            </x:Array>
                        </ComboBox.ItemsSource>
                    </ComboBox>

                    <Button Content="🔄 Réinitialiser" 
                           Command="{Binding ResetFiltersCommand}"
                           Style="{StaticResource SecondaryButtonStyle}"
                           Padding="10,5"/>
                </StackPanel>

                <!-- Refresh Button -->
                <Button Grid.Row="0" Grid.Column="1" 
                       Content="🔄 Actualiser"
                       Command="{Binding LoadDataCommand}"
                       Style="{StaticResource PrimaryButtonStyle}"
                       Padding="15,8"
                       VerticalAlignment="Center"/>

                <!-- Results Count -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                          FontSize="12" Foreground="Gray">
                    <Run Text="{Binding FilteredSalles.Count, Mode=OneWay}"/>
                    <Run Text="salle(s) trouvée(s)"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Loading Indicator -->
        <Border Grid.Row="1" 
               Background="#80000000"
               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
               Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳ Chargement..." 
                          FontSize="24" 
                          Foreground="White"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Salles List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredSalles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" 
                               Width="280" Height="350"
                               Margin="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Image -->
                                <Border Grid.Row="0" 
                                       Background="#ECF0F1"
                                       CornerRadius="5"
                                       Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock Text="📷" 
                                                  FontSize="48" 
                                                  Foreground="#BDC3C7"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        <!-- TODO: Add Image control with binding to ImgSallePath -->
                                    </Grid>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="{Binding Nom}" 
                                              FontSize="18" 
                                              FontWeight="Bold"
                                              Margin="0,0,0,5"/>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Text="N°: " Foreground="Gray"/>
                                        <TextBlock Text="{Binding Numero}" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Text="Type: " Foreground="Gray"/>
                                        <TextBlock Text="{Binding TypeSalle}" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Text="Étage: " Foreground="Gray"/>
                                        <TextBlock Text="{Binding Etage.Nom}" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Text="👥 " FontSize="14"/>
                                        <TextBlock Text="{Binding NbPlaces}" FontWeight="SemiBold"/>
                                        <TextBlock Text=" places" Foreground="Gray" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Row="2" 
                                           Orientation="Horizontal" 
                                           HorizontalAlignment="Right"
                                           Margin="0,10,0,0">
                                    <Button Content="{Binding Favori, Converter={StaticResource FavoriConverter}}"
                                           Command="{Binding DataContext.ToggleFavoriCommand, 
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Style="{StaticResource IconButtonStyle}"
                                           FontSize="18"
                                           ToolTip="Favori"/>
                                    
                                    <Button Content="ℹ️"
                                           Command="{Binding DataContext.ShowDetailsCommand, 
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Style="{StaticResource IconButtonStyle}"
                                           FontSize="18"
                                           ToolTip="Détails"/>
                                    
                                    <Button Content="🗑️"
                                           Command="{Binding DataContext.DeleteSalleCommand, 
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Style="{StaticResource IconButtonStyle}"
                                           FontSize="18"
                                           ToolTip="Supprimer"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
