<UserControl x:Class="WPF.Views.CreateEtageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:WPF.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="700"
             d:DataContext="{d:DesignInstance Type=viewmodels:CreateEtageViewModel}">
    
    <Border Style="{StaticResource CardStyle}" MaxWidth="650" Margin="20">
        <StackPanel>
            <TextBlock Text="🏢 Créer un nouvel étage" 
                      FontSize="24" 
                      FontWeight="Bold"
                      Margin="0,0,0,20"/>

            <GroupBox Header="Informations de l'étage" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="5">
                        <Label Content="Nom de l'étage *"/>
                        <TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14"
                                Padding="8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="5">
                        <Label Content="Niveau (numéro) *"/>
                        <TextBox Text="{Binding Niveau, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14"
                                Padding="8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="5">
                        <Label Content="Plan de l'étage (image)"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" 
                                    Text="{Binding ImagePath, Mode=OneWay}"
                                    IsReadOnly="True"
                                    FontSize="14"
                                    Padding="8"
                                    Margin="0,0,5,0"/>
                            <Button Grid.Column="1" 
                                   Content="📁 Parcourir"
                                   Command="{Binding SelectImageCommand}"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Padding="15,8"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Image Preview -->
            <Border Background="#ECF0F1" 
                   CornerRadius="5" 
                   Height="200"
                   Margin="0,0,0,20"
                   Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <TextBlock Text="📷 Aperçu du plan" 
                              FontSize="18" 
                              Foreground="#BDC3C7"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="{Binding ImagePath, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                    
                    <Image Source="{Binding ImagePath}" 
                          Stretch="Uniform"
                          Margin="10"
                          Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Right" 
                       Margin="0,20,0,0">
                <Button Content="❌ Annuler"
                       Command="{Binding CancelCommand}"
                       Style="{StaticResource SecondaryButtonStyle}"
                       Padding="20,10"
                       Margin="0,0,10,0"/>
                
                <Button Content="✅ Créer l'étage"
                       Command="{Binding SaveCommand}"
                       Style="{StaticResource PrimaryButtonStyle}"
                       Padding="20,10"
                       IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"/>
            </StackPanel>

            <!-- Saving Indicator -->
            <TextBlock Text="⏳ Enregistrement en cours..."
                      FontSize="14"
                      Foreground="Gray"
                      HorizontalAlignment="Center"
                      Margin="0,10,0,0"
                      Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <TextBlock Text="* Champs obligatoires"
                      FontSize="12"
                      Foreground="Gray"
                      Margin="0,20,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
